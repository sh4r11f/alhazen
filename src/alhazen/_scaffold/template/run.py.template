"""Run $name, in any of alhazen's six modes.

    python run.py --mode demo      --rig configs/rig-view.yaml
    python run.py --mode movie     --rig configs/rig-lab.yaml --out movies
    python run.py --mode measure   --rig configs/rig-lab.yaml
    python run.py --mode simulate  --rig configs/rig-sim.yaml --seed 1
    python run.py --mode test      --rig configs/rig-mouse.yaml --sub dev --ses 1
    python run.py                  --rig configs/rig-lab.yaml --sub s01 --ses 1

This exists so the experiment can be started without installing anything.
Once the package IS installed, ``alhazen run --task $task_name --mode ...``
does the same job through the same code.

The argument parser, the run-number counter, the rehearsal path — everything
every experiment needs — is alhazen's ``run_experiment``. What belongs here
is only what is about THIS experiment: its task class, and (once you write
them) where its subject-facing instructions come from.
"""

from __future__ import annotations

import sys
from pathlib import Path

from alhazen.cli.modes import run_experiment

from $package.task import $task_class

HERE = Path(__file__).parent

if __name__ == "__main__":
    raise SystemExit(
        run_experiment(
            task_class=$task_class,
            default_rig=HERE / "configs" / "rig-sim.yaml",
            default_params=HERE / "configs" / "task.yaml",
            argv=sys.argv[1:],
        )
    )
