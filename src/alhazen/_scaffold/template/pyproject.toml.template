[build-system]
requires = ["setuptools>=68"]
build-backend = "setuptools.build_meta"

[project]
name = "$name"
version = "0.1.0"
description = "An alhazen experiment"
requires-python = ">=3.10"
# alhazen-vision, not alhazen: the bare name on PyPI belongs to an
# unrelated project. The import stays `import alhazen`.
dependencies = ["alhazen-vision"]

[project.optional-dependencies]
# The renderer, needed only on a machine that opens a real window. The
# simulated backend — and this package's whole test suite — needs none of it.
psychopy = ["alhazen-vision[psychopy]"]
# The movie mode's encoder (`python run.py --mode movie`), for cutting
# distributable demos of the conditions. Separate because it ships an ffmpeg
# binary, which a rig that never writes a movie should not have to install.
movie = ["alhazen-vision[movie]"]
dev = ["pytest"]

# How `alhazen run --task $task_name` finds this experiment. The entry point
# names the Task subclass; installing this package is what registers it.
[project.entry-points."alhazen.tasks"]
$task_name = "$package.task:$task_class"

[tool.setuptools.packages.find]
where = ["src"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["src"]
