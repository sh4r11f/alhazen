# PURPOSE: watch the whole task run itself, with the live dashboard up.
#
#   python run.py --mode simulate --rig configs/rig-auto.yaml --seed 1
#
# A real window, so the trials are visible, driven by the task's own
# simulated subject (Task.simulation). A good simulated subject is
# deliberately imperfect — variable latencies, the occasional broken fixation
# or miss — so every outcome branch and every exclusion rule gets exercised
# and the saved data has a distribution in it rather than one repeated value.
#
# `devices` is empty on purpose: simulate mode injects the subject, and it
# refuses a rig that configures real hardware — driving a real tracker with
# an invented subject writes files that look exactly like a session and are
# not one.
#
# A simulated session takes as long as the session it rehearses — the clock
# is wall time — so point --params at a reduced copy of configs/task.yaml
# unless you want to sit through the full thing.
#
# The window is a slice of the panel: width_cm is what width_px of YOUR
# panel's pixels measure on the glass (see rig-view.yaml, which explains the
# arithmetic and the ruler check).
monitor:
  width_px: 1600
  height_px: 1200
  width_cm: 30.0
  distance_cm: 57.0
  refresh_rate_hz: 60.0
  screen_index: 0
  fullscreen: false

display:
  backend: psychopy
  # See rig-view.yaml: room for PsychoPy to find 10 identical frame
  # intervals under a desktop compositor.
  warmup_flips: 240
  frame_qa:
    # Mark drops on the trial record, so the analysis's dropped-frame
    # exclusion has something to find on a machine that is also running a
    # browser and a compositor.
    policy: mark_trial
    max_dropped_per_trial: 3

dashboard:
  # The live monitoring view, in a browser tab beside the stimulus window.
  # On for this mode: watching the dry run's panels fill is how you check
  # the dashboard itself before a subject is depending on it. It opens
  # BEFORE PsychoPy takes focus, so click the stimulus window afterwards —
  # some compositors throttle an unfocused surface.
  enabled: true
  auto_open: true
  port: 0

devices: {}

# Dry-run data lives apart from subject data. Simulate and test write to the
# rehearsal sibling of this root (data/dev-rehearsal), so `rm -rf data/dev*`
# resets everything including its own experiment database, and a simulated
# subject can never end up in the same table as a real one.
data_root: data/dev
