# PURPOSE: do the task yourself, with the mouse cursor as gaze.
#
#   python run.py --mode test --rig configs/rig-mouse.yaml --sub dev --ses 1
#
# The phases, the engine and the gaze regions behave exactly as on the rig,
# with your hand standing in for the subject's eye and your keyboard for
# theirs. This is the mode that tells you whether the task is DOABLE: whether
# the timings are livable, whether the target is findable, whether the
# response keys are comfortable. An eye is much faster than a hand, so if the
# timings feel tight here, that alone is not a reason to loosen them.
#
# P pauses; ESC in the pause menu quits.
#
# The window is a slice of the panel: width_cm is what width_px of YOUR
# panel's pixels measure on the glass (see rig-view.yaml, which explains the
# arithmetic and the ruler check).
monitor:
  width_px: 1600
  height_px: 1200
  width_cm: 30.0
  distance_cm: 57.0
  refresh_rate_hz: 60.0
  screen_index: 0
  fullscreen: false

display:
  backend: psychopy
  # See rig-view.yaml: room for PsychoPy to find 10 identical frame
  # intervals under a desktop compositor.
  warmup_flips: 240
  frame_qa:
    policy: warn

dashboard:
  # Off by default here: in this mode you are the subject, and a browser tab
  # stealing focus mid-trial is the one thing that breaks it. Set true if you
  # want to watch the panels instead of playing.
  enabled: false

devices:
  eyetracker:
    backend: mouse_sim   # the cursor stands in for gaze; no hardware involved

# Dry-run data lives apart from subject data. Test mode writes to the
# rehearsal sibling of this root (data/dev-rehearsal), so `rm -rf data/dev*`
# resets everything, and a rehearsal can never land where the analysis looks
# for subjects.
data_root: data/dev
