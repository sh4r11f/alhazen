"""The experiment: what a trial is made of.

Everything this file declares is this experiment's own — its parameters, the
events it marks, the outcomes a trial can have, and how one is built. The
frame loop, the devices, the data files and the scheduling all come from
alhazen, and none of them appear here.

Start by changing ``build_trial``: it returns the phases a trial runs
through, the stimuli they draw, and the regions they test gaze against.
"""

from __future__ import annotations

import numpy as np

from alhazen import (
    CircleRegion,
    Condition,
    Duration,
    Model,
    Task,
    TrialPlan,
    TrialSetup,
    outcomes,
)
from alhazen.core.events import EventSchema
from alhazen.paradigms.config import SchedulerConfig
from alhazen.stimuli.fixation import make_fixation
from alhazen.task import phases


class ${task_class}Params(Model):
    """Everything a session of this task needs, beyond the rig config.

    Durations are ``Duration`` values: give them in milliseconds or in
    display frames, and they resolve once against the measured refresh rate.
    Unknown keys in the YAML are rejected, so a typo fails at load naming the
    file.
    """

    fix_size_dva: float = 0.3
    fix_window_dva: float = 2.0
    acquire_timeout: Duration = Duration(ms=2000)
    hold_duration: Duration = Duration(ms=500)
    iti: Duration = Duration(ms=500)
    paradigm: SchedulerConfig = SchedulerConfig(n_per_condition=10)


class $task_class(Task):
    name = "$task_name"

    # The events this task marks. They become tracker messages, sync pulses
    # and rows in events.csv; declaring them is what lets a rig config's line
    # map be checked before a session runs.
    events = EventSchema(("FIX_ON", "FIX_ACQUIRED"))

    # What a trial can end as. `completed` is the flag the framework reads:
    # a non-completed outcome produced no measurement, so its condition is
    # served again rather than counted.
    outcomes = outcomes(
        FIXATED=dict(completed=True, success=True),
        FIX_BREAK=dict(completed=False),
        NO_FIXATION=dict(completed=True, success=False),
    )

    params_model = ${task_class}Params

    def conditions(self, rng: np.random.Generator) -> list[Condition]:
        """The cells this session varies over. One nameless condition is a
        perfectly good answer for a task whose trials do not differ."""
        return [Condition({"condition": "fixate"})]

    def build_trial(self, setup: TrialSetup) -> TrialPlan:
        params: ${task_class}Params = self.params  # type: ignore[assignment]
        hz = setup.refresh_rate_hz
        return TrialPlan(
            phases=[
                phases.AcquireFixation(
                    timeout_s=params.acquire_timeout.seconds(hz),
                    on_timeout=self.outcomes["NO_FIXATION"],
                ),
                phases.HoldFixation(
                    duration_s=params.hold_duration.seconds(hz),
                    on_break=self.outcomes["FIX_BREAK"],
                ),
                # HoldFixation advances rather than ending the trial, because
                # most tasks have something after the hold. A zero-length
                # Blank supplies the outcome when nothing does.
                phases.Blank(0.0, then=self.outcomes["FIXATED"]),
            ],
            stimuli={
                "fixation": make_fixation(setup.display, setup.screen, params.fix_size_dva)
            },
            regions={
                "fixation": CircleRegion(
                    (0.0, 0.0), setup.screen.deg2px(params.fix_window_dva)
                )
            },
        )

    # ------------------------------------------------------------------
    # The other modes (alhazen.modes). Each hook is optional — a task that
    # does not answer one is told plainly what to implement — but every rig
    # config this scaffold ships advertises them, so the smallest honest
    # version of each is here to build on.
    # ------------------------------------------------------------------

    def demo_views(self, setup):
        """What ``--mode demo`` shows: the fixation point, at session size.

        ``setup`` carries the real display and pixel scale, so what you
        judge on screen is the literal stimulus a session would draw. Add
        one view per display worth looking at.
        """
        from alhazen.modes.demo import DemoView

        params: ${task_class}Params = self.params  # type: ignore[assignment]
        fixation = make_fixation(setup.display, setup.screen, params.fix_size_dva)
        return [
            DemoView(
                name="fixation",
                caption="the fixation point, at the size a session draws it",
                draw=lambda elapsed: fixation.draw(),
            )
        ]

    def movie_clips(self, setup):
        """What ``--mode movie`` records: the trial as the subject sees it.

        One numpy frame per screen flip, in 0..1 — here the fixation point
        holding for its configured duration. The encoder, ``--scale`` and
        the contact sheet are alhazen's; only the pixels are this task's.
        (The encoder is the ``movie`` extra: ``pip install -e ".[movie]"``.)
        """
        from alhazen.modes.movie import MovieClip

        params: ${task_class}Params = self.params  # type: ignore[assignment]

        def frames():
            screen = setup.screen
            radius = screen.deg2px(params.fix_size_dva) / 2.0
            rows, cols = np.mgrid[0 : screen.height_px, 0 : screen.width_px]
            centre_r = (screen.height_px - 1) / 2.0
            centre_c = (screen.width_px - 1) / 2.0
            frame = np.full((screen.height_px, screen.width_px), 0.5, dtype=np.float32)
            frame[(cols - centre_c) ** 2 + (rows - centre_r) ** 2 <= radius**2] = 1.0
            for _ in range(round(params.hold_duration.seconds(setup.hz) * setup.hz)):
                yield frame

        return [MovieClip(name="fixation-hold", frames=frames)]

    def simulation(self, seed: int):
        """Who sits in the chair for ``--mode simulate``: a gaze that fixates.

        This task's one condition needs nothing subtler than a subject who
        looks at the point, which is what ``AutomatedGazeTracker`` is.
        Replace it with an imperfect subject of your own once there are
        outcome branches worth exercising — a rehearsal whose subject never
        blinks or misses exercises none of the exclusion rules.
        """
        from alhazen.devices.automated import AutomatedGazeTracker
        from alhazen.modes.simulation import Simulation

        return Simulation(
            tracker=AutomatedGazeTracker(),
            describe={"seed": seed, "source": "alhazen.devices.automated"},
        )
